# ---------------------------------------------------------------------------
# Server-side only. NEVER prefix this with VITE_ — anything VITE_ prefixed is
# inlined into the browser bundle. Set this in the Netlify UI under
# Site settings → Environment variables.
# Without it, Pulse serves a clearly-labelled sample growth pack instead.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1 — fast and inexpensive, and the pack is built
# from three parallel calls so a full generation takes roughly 15-20 seconds.
OPENAI_MODEL=gpt-4.1

# ---------------------------------------------------------------------------
# Public (browser) values. Safe to expose — the anon key is protected by the
# row level security policies in supabase/schema.sql.
# Without these, generations are stored in the browser's localStorage only.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
